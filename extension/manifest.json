{
  "manifest_version": 3,
  "name": "Loes lokaal geheugen",
  "version": "0.1.2",
  "description": "Lokaal persoonlijk geheugen voor chat.loes.ai",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.loes.ai/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.loes.ai/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
